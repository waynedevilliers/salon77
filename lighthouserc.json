{
  "ci": {
    "collect": {
      "startServerCommand": "npm start -- -p 3300",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3300/",
        "http://localhost:3300/uebersicht",
        "http://localhost:3300/unterricht",
        "http://localhost:3300/wochenkurse",
        "http://localhost:3300/dozenten",
        "http://localhost:3300/veranstaltungen",
        "http://localhost:3300/veranstaltungen/klein-montmartre",
        "http://localhost:3300/raeumlichkeiten",
        "http://localhost:3300/verein",
        "http://localhost:3300/kontakt",
        "http://localhost:3300/impressum",
        "http://localhost:3300/datenschutz"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 667,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    }
  }
}
