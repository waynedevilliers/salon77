# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git and must never be committed.

# SMTP server used to send registration emails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# true for port 465, false for other ports
EMAIL_SECURE=false
# Leave EMAIL_USER and EMAIL_PASS empty if the server needs no login
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Salon77 <info@salon77.de>"

# Address that receives Klein-Montmartre registrations.
# EMAIL_HOST, EMAIL_FROM and REGISTRATION_EMAIL are required; without them the
# form shows an error with a short code instead of sending.
REGISTRATION_EMAIL=
