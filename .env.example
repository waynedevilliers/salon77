# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git and must never be committed.

# SMTP server used to send registration emails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# true for port 465, false for other ports
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Salon77 <info@salon77.de>"

# Address that receives Klein-Montmartre registrations
REGISTRATION_EMAIL=
